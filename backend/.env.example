# 服务监听地址
SERVER_ADDR=0.0.0.0:8080

# SQLite 数据库文件路径
# - 相对路径(相对 backend 目录):  sqlite:./data/admin.db
# - 绝对路径(Windows):           sqlite:C:\path\to\admin.db
# - 内存库(仅调试):              sqlite::memory:
DATABASE_URL=sqlite:./data/admin.db

# JWT 配置
JWT_SECRET=please-change-me-in-production
JWT_EXPIRE_HOURS=24

# bcrypt 计算 cost(4~12,越大越慢越安全)
BCRYPT_COST=10

# 日志级别:trace / debug / info / warn / error
RUST_LOG=info,admin_starter_backend=debug,tower_http=info
